{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "baseUrl": {
      "type": "string"
    },
    "group": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rank": {
          "type": "number",
          "description": "Position of the group in the tab, an integer from 1."
        }
      },
      "required": [
        "name",
        "rank"
      ],
      "additionalProperties": false,
      "description": "Places the plugin in its own group in the **Plugins** tab, separated from the rest. Omitted, the plugin joins the last group. Read as `item.group.name` / `item.group.rank`."
    },
    "guid": {
      "type": "string"
    },
    "help": {
      "type": "string",
      "description": "A help/support link for the plugin."
    },
    "onlyofficeScheme": {
      "type": "boolean",
      "description": "On desktop editors, serves the plugin through the `onlyoffice://` custom scheme instead of `file://`, so it gets a real origin with working CORS and a secure context."
    },
    "minVersion": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "nameLocale": {
      "$ref": "#/definitions/Record%3Cstring%2Cstring%3E"
    },
    "offered": {
      "type": "string",
      "description": "The plugin author who proposed the plugin for publication."
    },
    "variations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/VariationConfig"
      },
      "contains": {
        "required": [
          "store"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "version": {
      "type": "string",
      "description": "The plugin's own version, e.g. `\"1.0\"`. Optional per the reference, and genuinely omitted by shipped plugins - `guid`, `name` and `variations` are the only required top-level fields."
    }
  },
  "required": [
    "guid",
    "minVersion",
    "name",
    "offered",
    "variations",
    "version"
  ],
  "additionalProperties": false,
  "definitions": {
    "Record<string,string>": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "VariationConfig": {
      "type": "object",
      "properties": {
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ButtonConfig"
          },
          "description": "Defaults to no buttons (an empty toolbar) when omitted - routinely omitted in practice."
        },
        "cryptoDisabledForExternalCloud": {
          "type": "string"
        },
        "cryptoDisabledForInternalCloud": {
          "type": "string"
        },
        "cryptoDisabledOnStart": {
          "type": "string"
        },
        "cryptoMode": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "descriptionLocale": {
          "$ref": "#/definitions/Record%3Cstring%2Cstring%3E"
        },
        "EditorsSupport": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EditorType"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixedSize": {
          "type": "boolean"
        },
        "icons": {
          "anyOf": [
            {
              "$ref": "#/definitions/Record%3Cstring%2Cstring%3E"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/IconConfig"
              }
            }
          ],
          "description": "Some plugins use the same rich per-scale shape here as `icons2` instead of a plain path/map."
        },
        "icons2": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IconConfig"
          }
        },
        "initData": {
          "type": "string"
        },
        "initDataType": {
          "$ref": "#/definitions/InitDataType"
        },
        "initOnSelectionChanged": {
          "type": "boolean"
        },
        "isCanDocked": {
          "type": "boolean"
        },
        "isCustomWindow": {
          "type": "boolean"
        },
        "isDisplayedInViewer": {
          "type": "boolean"
        },
        "isInsideMode": {
          "type": "boolean"
        },
        "isModal": {
          "type": "boolean"
        },
        "isActivated": {
          "type": "boolean",
          "description": "Whether the created panel starts expanded (`true`, the default) or collapsed (`false`).\n\nPanel variations only - `type` of `\"panel\"` or `\"panelRight\"`. The side-menu button and the panel are created either way; `false` only skips expanding it on render, leaving the user to open it from the button. Read as `isActivated !== false`, so omitting it and setting it to `true` are the same - only `false` does anything."
        },
        "isSystem": {
          "type": "boolean"
        },
        "isTargeted": {
          "type": "boolean"
        },
        "isUpdateOleOnResize": {
          "type": "boolean"
        },
        "isViewer": {
          "type": "boolean"
        },
        "isVisual": {
          "type": "boolean",
          "description": "Omitted in practice about as often as it's set explicitly."
        },
        "menu": {
          "$ref": "#/definitions/MenuType"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "executeMethod names this variation calls - purely descriptive/documentation, not enforced."
        },
        "name": {
          "type": "string"
        },
        "nameLocale": {
          "$ref": "#/definitions/Record%3Cstring%2Cstring%3E"
        },
        "screens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Store listing screenshots for this specific variation (see also StoreConfig.screenshots)."
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "store": {
          "$ref": "#/definitions/StoreConfig"
        },
        "type": {
          "$ref": "#/definitions/VariationType"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "EditorsSupport",
        "url"
      ],
      "additionalProperties": false
    },
    "ButtonConfig": {
      "type": "object",
      "properties": {
        "isViewer": {
          "type": "boolean"
        },
        "primary": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "textLocale": {
          "$ref": "#/definitions/Record%3Cstring%2Cstring%3E"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "EditorType": {
      "type": "string",
      "enum": [
        "word",
        "cell",
        "slide",
        "pdf"
      ]
    },
    "IconConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ],
          "description": "Light/dark icon set variant - real-world config.json files pair this with `theme`."
        },
        "theme": {
          "type": "string",
          "description": "Icon theme name, e.g. `\"flat\"`/`\"flatDark\"` - not a fixed enum in practice."
        },
        "default": {
          "$ref": "#/definitions/IconScaleEntry",
          "description": "Fallback used for any scale not otherwise listed."
        },
        "100%": {
          "$ref": "#/definitions/IconScaleEntry"
        },
        "125%": {
          "$ref": "#/definitions/IconScaleEntry"
        },
        "150%": {
          "$ref": "#/definitions/IconScaleEntry"
        },
        "175%": {
          "$ref": "#/definitions/IconScaleEntry"
        },
        "200%": {
          "$ref": "#/definitions/IconScaleEntry"
        }
      }
    },
    "IconScaleEntry": {
      "type": "object",
      "properties": {
        "active": {
          "type": "string"
        },
        "hover": {
          "type": "string"
        },
        "normal": {
          "type": "string"
        }
      },
      "required": [
        "normal"
      ],
      "additionalProperties": false
    },
    "InitDataType": {
      "type": "string",
      "enum": [
        "text",
        "html",
        "ole",
        "desktop",
        "desktop-external",
        "none",
        "sign"
      ]
    },
    "MenuType": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ]
    },
    "StoreConfig": {
      "type": "object",
      "properties": {
        "background": {
          "type": "object",
          "properties": {
            "dark": {
              "type": "string"
            },
            "light": {
              "type": "string"
            }
          },
          "required": [
            "dark",
            "light"
          ],
          "additionalProperties": false
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "icons": {
          "type": "object",
          "properties": {
            "dark": {
              "type": "string"
            },
            "light": {
              "type": "string"
            }
          },
          "required": [
            "dark",
            "light"
          ],
          "additionalProperties": false
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "background",
        "icons",
        "screenshots"
      ]
    },
    "VariationType": {
      "type": "string",
      "enum": [
        "window",
        "panel",
        "panelRight",
        "background",
        "system"
      ]
    }
  },
  "$id": "https://raw.githubusercontent.com/ONLYOFFICE/doceditor-plugin-types/master/schemas/config.schema.json",
  "title": "ONLYOFFICE Plugin config.json",
  "description": "Generated from PluginConfig (and the types it references) in index.d.ts - do not hand-edit, run `npm run generate-schema` instead."
}
