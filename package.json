{
  "name": "@onlyoffice/doceditor-plugin-types",
  "version": "10.0.0",
  "description": "TypeScript type definitions for the ONLYOFFICE Document Editor plugin API",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ONLYOFFICE/doceditor-plugin-types/issues",
    "email": "support@onlyoffice.com"
  },
  "homepage": "https://api.onlyoffice.com/docs/plugins/get-started/overview/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONLYOFFICE/doceditor-plugin-types.git"
  },
  "author": {
    "name": "Ascensio System SIA",
    "email": "integration@onlyoffice.com",
    "url": "https://www.onlyoffice.com"
  },
  "maintainers": [
    {
      "name": "Ascensio System SIA",
      "email": "integration@onlyoffice.com",
      "url": "https://www.onlyoffice.com"
    }
  ],
  "keywords": [
    "onlyoffice",
    "onlyoffice-docs",
    "document-server",
    "plugin",
    "plugins-api",
    "typescript",
    "types"
  ],
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./word": {
      "types": "./src/editors/word.d.ts"
    },
    "./cell": {
      "types": "./src/editors/cell.d.ts"
    },
    "./slide": {
      "types": "./src/editors/slide.d.ts"
    },
    "./pdf": {
      "types": "./src/editors/pdf.d.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.d.ts"
    },
    "./plugin/*": {
      "types": "./src/plugin/*.d.ts"
    },
    "./config": {
      "types": "./src/config/index.d.ts"
    },
    "./services": {
      "types": "./src/services/index.d.ts"
    },
    "./config/schema.json": "./schemas/config.schema.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "word": [
        "src/editors/word.d.ts"
      ],
      "cell": [
        "src/editors/cell.d.ts"
      ],
      "slide": [
        "src/editors/slide.d.ts"
      ],
      "pdf": [
        "src/editors/pdf.d.ts"
      ],
      "plugin": [
        "src/plugin/index.d.ts"
      ],
      "plugin/*": [
        "src/plugin/*"
      ],
      "config": [
        "src/config/index.d.ts"
      ],
      "services": [
        "src/services/index.d.ts"
      ]
    }
  },
  "files": [
    "index.d.ts",
    "src",
    "schemas",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "!src/generated/generation-manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate-types.js",
    "postgenerate": "node scripts/generate-plugin-methods.js && node scripts/generate-runtime-index.js && node scripts/generate-ambient-bundle.js",
    "generate-plugin-methods": "node scripts/generate-plugin-methods.js",
    "generate-runtime-index": "node scripts/generate-runtime-index.js",
    "generate-schema": "node scripts/generate-config-schema.js",
    "generate-ambient": "node scripts/generate-ambient-bundle.js",
    "check-generated": "npm run generate -- --require-clean-sources && git diff --exit-code -- src/generated",
    "check-release-sources": "npm run generate -- --require-clean-sources --require-release-tag && git diff --exit-code -- src/generated",
    "check-runtime-index": "npm run generate-runtime-index && git diff --exit-code -- artifacts/api",
    "check-schema": "npm run generate-schema && git diff --exit-code -- schemas/config.schema.json",
    "check-runtime": "node scripts/check-runtime-contract.js",
    "check-plugin-events": "node scripts/check-plugin-events.js",
    "validate-schema": "node scripts/validate-config-schema.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:shared && npm run test:word && npm run test:cell && npm run test:slide && npm run test:pdf && npm run test:forms",
    "test:shared": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:word": "tsc --noEmit -p tsconfig.test.word.json",
    "test:cell": "tsc --noEmit -p tsconfig.test.cell.json",
    "test:slide": "tsc --noEmit -p tsconfig.test.slide.json",
    "test:pdf": "tsc --noEmit -p tsconfig.test.pdf.json",
    "test:forms": "tsc --noEmit -p tsconfig.test.forms.json",
    "check-arity": "node scripts/check-arity.js",
    "check-structure": "node scripts/check-structure.js",
    "check-package": "node scripts/check-package-contents.js"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "jsdoc": "^4.0.5",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3"
  }
}
