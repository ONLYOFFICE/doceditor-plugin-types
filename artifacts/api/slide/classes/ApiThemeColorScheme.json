{
  "description": "Class representing a theme color scheme.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiThemeColorScheme/",
  "methods": {
    "ChangeColor": {
      "description": "Changes a color in the theme color scheme.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiThemeColorScheme/Methods/ChangeColor/",
      "params": [
        {
          "description": "Color position in the color scheme which will be changed.",
          "name": "nPos",
          "type": "number"
        },
        {
          "description": "New color of the theme color scheme.",
          "name": "oColor",
          "type": "ApiUniColor | ApiRGBColor"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "ChangeColor(nPos: number, oColor: ApiUniColor | ApiRGBColor): boolean"
    },
    "Copy": {
      "description": "Creates a copy of the current theme color scheme.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiThemeColorScheme/Methods/Copy/",
      "params": [],
      "returns": {
        "type": "ApiThemeColorScheme"
      },
      "signature": "Copy(): ApiThemeColorScheme"
    },
    "GetClassType": {
      "description": "Returns the type of the ApiThemeColorScheme class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiThemeColorScheme/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"themeColorScheme\""
      },
      "signature": "GetClassType(): \"themeColorScheme\""
    },
    "SetSchemeName": {
      "description": "Sets a name to the current theme color scheme.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiThemeColorScheme/Methods/SetSchemeName/",
      "params": [
        {
          "description": "Theme color scheme name.",
          "name": "sName",
          "type": "string"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetSchemeName(sName: string): boolean"
    },
    "ToJSON": {
      "description": "Converts the ApiThemeColorScheme object into the JSON object.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiThemeColorScheme/Methods/ToJSON/",
      "params": [],
      "returns": {
        "type": "object"
      },
      "signature": "ToJSON(): object"
    }
  }
}
