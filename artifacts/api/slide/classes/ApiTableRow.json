{
  "agents": "https://raw.githubusercontent.com/ONLYOFFICE/plugins-types/main/AGENTS.md",
  "description": "Class representing a table row.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiTableRow/",
  "extends": [
    "ApiTableRowPr"
  ],
  "methods": {
    "GetCell": {
      "description": "Returns a cell by its position in the current row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiTableRow/Methods/GetCell/",
      "params": [
        {
          "description": "The cell position in the table row.",
          "name": "nPos",
          "type": "number"
        }
      ],
      "returns": {
        "type": "ApiTableCell"
      },
      "signature": "GetCell(nPos: number): ApiTableCell"
    },
    "GetCellsCount": {
      "description": "Returns a number of cells in the current row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiTableRow/Methods/GetCellsCount/",
      "params": [],
      "returns": {
        "type": "number"
      },
      "signature": "GetCellsCount(): number"
    },
    "GetClassType": {
      "description": "Returns the type of the ApiTableRow class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiTableRow/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"tableRow\""
      },
      "signature": "GetClassType(): \"tableRow\""
    },
    "GetHeight": {
      "description": "Returns the height of the current table row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiTableRow/Methods/GetHeight/",
      "params": [],
      "returns": {
        "type": "EMU | null"
      },
      "signature": "GetHeight(): EMU | null",
      "since": "9.4.0"
    },
    "GetNext": {
      "description": "Returns the next row if exists.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiTableRow/Methods/GetNext/",
      "params": [],
      "returns": {
        "description": "returns null if row is last.",
        "type": "ApiTableRow | null"
      },
      "signature": "GetNext(): ApiTableRow | null"
    },
    "GetParentTable": {
      "description": "Returns the parent table of the current row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiTableRow/Methods/GetParentTable/",
      "params": [],
      "returns": {
        "description": "returns null if parent table doesn't exist.",
        "type": "ApiTable | null"
      },
      "signature": "GetParentTable(): ApiTable | null"
    },
    "GetPrevious": {
      "description": "Returns the previous row if exists.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiTableRow/Methods/GetPrevious/",
      "params": [],
      "returns": {
        "description": "returns null if row is first.",
        "type": "ApiTableRow | null"
      },
      "signature": "GetPrevious(): ApiTableRow | null"
    },
    "SetHeight": {
      "description": "Sets the height to the current table row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiTableRow/Methods/SetHeight/",
      "params": [
        {
          "description": "The row height in English measure units.",
          "name": "nValue",
          "optional": true,
          "type": "EMU"
        }
      ],
      "returns": {
        "type": "EMU | null"
      },
      "signature": "SetHeight(nValue?: EMU): EMU | null",
      "since": "5.1.0"
    }
  }
}
