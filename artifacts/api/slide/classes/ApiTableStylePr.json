      "params": [
        {
          "description": "The table properties to apply.",
          "name": "oTablePr",
          "type": "ApiTablePr"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetTablePr(oTablePr: ApiTablePr): boolean",
      "since": "10.0.0"
    }
  }
}
