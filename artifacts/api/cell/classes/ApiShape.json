{
  "description": "Class representing a shape.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/",
  "extends": [
    "ApiDrawing"
  ],
  "methods": {
    "GetClassType": {
      "description": "Returns a type of the ApiShape class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"shape\""
      },
      "signature": "GetClassType(): \"shape\""
    },
    "GetContent": {
      "description": "Returns the shape inner contents where a paragraph or text runs can be inserted.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/GetContent/",
      "params": [],
      "returns": {
        "type": "ApiDocumentContent"
      },
      "signature": "GetContent(): ApiDocumentContent"
    },
    "GetDocContent": {
      "description": "Returns the shape inner contents where a paragraph or text runs can be inserted.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/GetDocContent/",
      "params": [],
      "returns": {
        "type": "ApiDocumentContent"
      },
      "signature": "GetDocContent(): ApiDocumentContent"
    },
    "GetGeometry": {
      "description": "Returns the geometry object from the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/GetGeometry/",
      "params": [],
      "returns": {
        "type": "ApiGeometry"
      },
      "signature": "GetGeometry(): ApiGeometry",
      "since": "9.1.0"
    },
    "GetLine": {
      "description": "Gets the outline properties from the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/GetLine/",
      "params": [],
      "returns": {
        "type": "ApiStroke | null"
      },
      "signature": "GetLine(): ApiStroke | null"
    },
    "GetParentSheet": {
      "description": "Returns the parent sheet of the current drawing.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiDrawing/Methods/GetParentSheet/",
      "params": [],
      "returns": {
        "type": "ApiWorksheet"
      },
      "signature": "GetParentSheet(): ApiWorksheet",
      "since": "8.3.0"
    },
    "GetPosition": {
      "description": "Returns the cell anchor of the current drawing; the offsets are limited by the anchor cell.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiDrawing/Methods/GetPosition/",
      "params": [],
      "returns": {
        "description": "returns null for an absolutely positioned drawing.",
        "type": "DrawingCellAnchor | null"
      },
      "signature": "GetPosition(): DrawingCellAnchor | null",
      "since": "10.0.0"
    },
    "GetVerticalTextAlign": {
      "description": "Gets the vertical alignment from the shape content where a paragraph or text runs can be inserted.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/GetVerticalTextAlign/",
      "params": [],
      "returns": {
        "type": "VerticalTextAlign"
      },
      "signature": "GetVerticalTextAlign(): VerticalTextAlign"
    },
    "SetGeometry": {
      "description": "Sets a custom geometry for the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/SetGeometry/",
      "params": [
        {
          "description": "The geometry to set.",
          "name": "oGeometry",
          "type": "ApiGeometry"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetGeometry(oGeometry: ApiGeometry): boolean",
      "since": "9.1.0"
    },
    "SetLine": {
      "description": "Sets the outline properties to the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/SetLine/",
      "params": [
        {
          "description": "The stroke used to create the shape outline.",
          "name": "oStroke",
          "type": "ApiStroke"
        }
      ],
      "returns": {
        "description": "returns false if param is invalid.",
        "type": "boolean"
      },
      "signature": "SetLine(oStroke: ApiStroke): boolean"
    },
    "SetPaddings": {
      "description": "Sets the text paddings to the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/SetPaddings/",
      "params": [
        {
          "description": "Left padding.",
          "name": "nLeft",
          "type": "EMU"
        },
        {
          "description": "Top padding.",
          "name": "nTop",
          "type": "EMU"
        },
        {
          "description": "Right padding.",
          "name": "nRight",
          "type": "EMU"
        },
        {
          "description": "Bottom padding.",
          "name": "nBottom",
          "type": "EMU"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetPaddings(nLeft: EMU, nTop: EMU, nRight: EMU, nBottom: EMU): boolean"
    },
    "SetVerticalTextAlign": {
      "description": "Sets the vertical alignment to the shape content where a paragraph or text runs can be inserted.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/spreadsheet-api/ApiShape/Methods/SetVerticalTextAlign/",
      "params": [
        {
          "description": "The vertical alignment type for the shape inner contents.",
          "name": "verticalAlign",
          "type": "VerticalTextAlign"
        }
      ],
      "returns": {
        "description": "returns false if shape or aligment doesn't exist.",
        "type": "boolean"
      },
      "signature": "SetVerticalTextAlign(verticalAlign: VerticalTextAlign): boolean"
    }
  }
}
