{
  "description": "Class representing a rich paragraph.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/",
  "extends": [
    "ApiRichParaPr"
  ],
  "methods": {
    "AddElement": {
      "description": "Adds an element to the current paragraph.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/AddElement/",
      "params": [
        {
          "description": "The element which will be added at the current position.",
          "name": "richRun",
          "type": "ApiRichRun"
        },
        {
          "description": "The position where the current element will be added. If this value is not\rspecified, then the element will be added at the end of the current paragraph.",
          "name": "pos",
          "optional": true,
          "type": "number"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "AddElement(richRun: ApiRichRun, pos?: number): boolean"
    },
    "AddText": {
      "description": "Adds some text to the current paragraph.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/AddText/",
      "params": [
        {
          "description": "The text that we want to insert into the current paragraph.",
          "name": "text",
          "type": "string"
        }
      ],
      "returns": {
        "type": "ApiRichRun"
      },
      "signature": "AddText(text: string): ApiRichRun"
    },
    "Copy": {
      "description": "Creates a paragraph copy.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/Copy/",
      "params": [],
      "returns": {
        "type": "ApiRichParagraph"
      },
      "signature": "Copy(): ApiRichParagraph"
    },
    "Delete": {
      "description": "Deletes the current paragraph.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/Delete/",
      "params": [],
      "returns": {
        "description": "returns false if paragraph haven't parent.",
        "type": "boolean"
      },
      "signature": "Delete(): boolean"
    },
    "GetClassType": {
      "description": "Returns a type of the ApiRichParagraph class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"richParagraph\""
      },
      "signature": "GetClassType(): \"richParagraph\""
    },
    "GetElement": {
      "description": "Returns a paragraph element using the position specified.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/GetElement/",
      "params": [
        {
          "description": "The position where the element which content we want to get must be located.",
          "name": "pos",
          "type": "number"
        }
      ],
      "returns": {
        "type": "ApiRichRun | null"
      },
      "signature": "GetElement(pos: number): ApiRichRun | null"
    },
    "GetElementsCount": {
      "description": "Returns a number of elements in the current paragraph.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/GetElementsCount/",
      "params": [],
      "returns": {
        "type": "number"
      },
      "signature": "GetElementsCount(): number"
    },
    "GetJc": {
      "description": "Returns the rich paragraph contents justification.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParaPr/Methods/GetJc/",
      "params": [],
      "returns": {
        "type": "HorTextAlign"
      },
      "signature": "GetJc(): HorTextAlign"
    },
    "GetLastRunWithText": {
      "description": "Returns the last Run with text in the current paragraph.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/GetLastRunWithText/",
      "params": [],
      "returns": {
        "type": "ApiRun"
      },
      "signature": "GetLastRunWithText(): ApiRun",
      "since": "10.0.0"
    },
    "GetNext": {
      "description": "Returns the next paragraph.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/GetNext/",
      "params": [],
      "returns": {
        "description": "returns null if paragraph is last.",
        "type": "ApiRichParagraph | null"
      },
      "signature": "GetNext(): ApiRichParagraph | null"
    },
    "GetParaPr": {
      "description": "Returns the paragraph properties.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/GetParaPr/",
      "params": [],
      "returns": {
        "type": "ApiRichParaPr"
      },
      "signature": "GetParaPr(): ApiRichParaPr"
    },
    "GetPosInParent": {
      "description": "Returns the paragraph position within its parent element.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/GetPosInParent/",
      "params": [],
      "returns": {
        "description": "returns -1 if the paragraph parent doesn't exist.",
        "type": "number"
      },
      "signature": "GetPosInParent(): number"
    },
    "GetPrevious": {
      "description": "Returns the previous paragraph.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/GetPrevious/",
      "params": [],
      "returns": {
        "description": "returns null if paragraph is first.",
        "type": "ApiRichParagraph | null"
      },
      "signature": "GetPrevious(): ApiRichParagraph | null"
    },
    "GetText": {
      "description": "Returns the paragraph text.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/GetText/",
      "params": [
        {
          "description": "Options for formatting the returned text.",
          "name": "options",
          "optional": true,
          "type": "{ NewLineSeparator?: string; TabSymbol?: string }"
        }
      ],
      "returns": {
        "type": "string"
      },
      "signature": "GetText(options?: { NewLineSeparator?: string; TabSymbol?: string }): string"
    },
    "Last": {
      "description": "Returns the last element of the paragraph.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/Last/",
      "params": [],
      "returns": {
        "type": "ApiRichRun"
      },
      "signature": "Last(): ApiRichRun"
    },
    "Push": {
      "description": "Adds an element to the current paragraph.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/Push/",
      "params": [
        {
          "description": "The element to add at the end of the paragraph.",
          "name": "richRun",
          "type": "ParagraphContent"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "Push(richRun: ParagraphContent): boolean"
    },
    "RemoveAllElements": {
      "description": "Removes all the elements from the current paragraph.\n\n**Note:**\nWhen all the elements are removed from the paragraph, a new empty run is automatically created.\n",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/RemoveAllElements/",
      "params": [],
      "returns": {
        "type": "boolean"
      },
      "signature": "RemoveAllElements(): boolean"
    },
    "RemoveElement": {
      "description": "Removes an element using the position specified.\n\n**Note:**\nIf the element you remove is the last paragraph element (i.e. all the elements are removed from the paragraph),\na new empty run is automatically created.\n",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/RemoveElement/",
      "params": [
        {
          "description": "The element position which we want to remove from the paragraph.",
          "name": "pos",
          "type": "number"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "RemoveElement(pos: number): boolean"
    },
    "SetJc": {
      "description": "Sets the rich paragraph contents justification.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParaPr/Methods/SetJc/",
      "params": [
        {
          "description": "The justification type that will be applied to the rich paragraph contents.",
          "name": "jc",
          "type": "HorTextAlign"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetJc(jc: HorTextAlign): boolean"
    },
    "SetParaPr": {
      "description": "Sets the paragraph properties.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/SetParaPr/",
      "params": [
        {
          "description": "The paragraph properties to apply.",
          "name": "paraPr",
          "type": "ApiRichParaPr"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetParaPr(paraPr: ApiRichParaPr): boolean"
    },
    "SetReadingOrder": {
      "description": "Specifies the reading order for the current paragraph.\n\nPossible values are:\n\n- **null** - use the standart direction parameter;\n- **\"ltr\"** - left-to-right text direction;\n- **\"rtl\"** - right-to-left text direction.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichParagraph/Methods/SetReadingOrder/",
      "params": [
        {
          "description": "The reading order.",
          "name": "readingOrder",
          "optional": true,
          "type": "ReadingOrder | null"
        }
      ],
      "returns": {
        "description": "Returns the current paragraph itself (ApiRichParagraph).",
        "type": "ApiRichParagraph"
      },
      "signature": "SetReadingOrder(readingOrder?: ReadingOrder | null): ApiRichParagraph"
    }
  }
}
