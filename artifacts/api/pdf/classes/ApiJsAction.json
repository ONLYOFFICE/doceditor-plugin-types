{
  "description": "Class representing a js action.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiJsAction/",
  "extends": [
    "ApiBaseAction"
  ],
  "methods": {
    "GetClassType": {
      "description": "Returns a type of the ApiJsAction class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiJsAction/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"jsAction\""
      },
      "signature": "GetClassType(): \"jsAction\"",
      "since": "10.0.0"
    },
    "GetNext": {
      "description": "Returns next action.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseAction/Methods/GetNext/",
      "params": [],
      "returns": {
        "type": "ApiBaseAction"
      },
      "signature": "GetNext(): ApiBaseAction",
      "since": "10.0.0"
    },
    "GetScript": {
      "description": "Gets action script",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiJsAction/Methods/GetScript/",
