{
  "description": "Class representing a table row.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/",
  "extends": [
    "ApiTableRowPr"
  ],
  "methods": {
    "AddRows": {
      "description": "Adds the new rows to the current table.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/AddRows/",
      "params": [
        {
          "description": "Count of rows to be added.",
          "name": "nCount",
          "type": "number"
        },
        {
          "description": "Specifies if the rows will be added before or after the current row.",
          "name": "isBefore",
          "optional": true,
          "type": "boolean"
        }
      ],
      "returns": {
        "description": "returns null if parent table doesn't exist.",
        "type": "ApiTable | null"
      },
      "signature": "AddRows(nCount: number, isBefore?: boolean): ApiTable | null",
      "since": "10.0.0"
    },
    "Clear": {
      "description": "Clears the content from the current row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/Clear/",
      "params": [],
      "returns": {
        "description": "returns false if parent table doesn't exist.",
        "type": "boolean"
      },
      "signature": "Clear(): boolean",
      "since": "10.0.0"
    },
    "GetCell": {
      "description": "Returns a cell by its position in the current row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/GetCell/",
      "params": [
        {
          "description": "The zero-based cell index in the table row.",
          "name": "cellIndex",
          "type": "number"
        }
      ],
      "returns": {
        "type": "ApiTableCell"
      },
      "signature": "GetCell(cellIndex: number): ApiTableCell"
    },
    "GetCellsCount": {
      "description": "Returns a number of cells in the current row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/GetCellsCount/",
      "params": [],
      "returns": {
        "type": "number"
      },
      "signature": "GetCellsCount(): number"
    },
    "GetClassType": {
      "description": "Returns the type of the ApiTableRow class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"tableRow\""
      },
      "signature": "GetClassType(): \"tableRow\""
    },
    "GetHeight": {
      "description": "Gets the height from the current table row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/GetHeight/",
      "params": [],
      "returns": {
        "type": "EMU"
      },
      "signature": "GetHeight(): EMU",
      "since": "10.0.0"
    },
    "GetIndex": {
      "description": "Returns the current row index.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/GetIndex/",
      "params": [],
      "returns": {
        "type": "number"
      },
      "signature": "GetIndex(): number",
      "since": "10.0.0"
    },
    "GetInternalId": {
      "description": "Returns an internal ID of the current table row.\nThe internal ID is valid only for the current editing session: it stays the same while the document is open,\nbut it is not saved to the file and can be different after the document is reopened.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/GetInternalId/",
      "params": [],
      "returns": {
        "type": "string"
      },
      "signature": "GetInternalId(): string",
      "since": "10.0.0"
    },
    "GetNext": {
      "description": "Returns the next row if exists.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/GetNext/",
      "params": [],
      "returns": {
        "description": "returns null if row is last.",
        "type": "ApiTableRow | null"
      },
      "signature": "GetNext(): ApiTableRow | null",
      "since": "10.0.0"
    },
    "GetParentTable": {
      "description": "Returns the parent table of the current row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/GetParentTable/",
      "params": [],
      "returns": {
        "description": "returns null if parent table doesn't exist.",
        "type": "ApiTable | null"
      },
      "signature": "GetParentTable(): ApiTable | null",
      "since": "10.0.0"
    },
    "GetPrevious": {
      "description": "Returns the previous row if exists.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/GetPrevious/",
      "params": [],
      "returns": {
        "description": "returns null if row is first.",
        "type": "ApiTableRow | null"
      },
      "signature": "GetPrevious(): ApiTableRow | null",
      "since": "10.0.0"
    },
    "MergeCells": {
      "description": "Merges the cells in the current row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/MergeCells/",
      "params": [],
      "returns": {
        "description": "return null if can't merge.",
        "type": "ApiTableCell | null"
      },
      "signature": "MergeCells(): ApiTableCell | null",
      "since": "10.0.0"
    },
    "Remove": {
      "description": "Removes the current table row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/Remove/",
      "params": [],
      "returns": {
        "description": "return false if parent table doesn't exist.",
        "type": "boolean"
      },
      "signature": "Remove(): boolean",
      "since": "10.0.0"
    },
    "SetBackgroundColor": {
      "description": "Sets the background color to all cells in the current table row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/SetBackgroundColor/",
      "params": [
        {
          "description": "If not passed, the background color will be cleared.",
          "name": "color",
          "optional": true,
          "type": "ApiColor"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetBackgroundColor(color?: ApiColor): boolean",
      "since": "10.0.0"
    },
    "SetHeight": {
      "description": "Sets the height to the current table row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/SetHeight/",
      "params": [
        {
          "description": "The row height in English measure units.",
          "name": "height",
          "type": "EMU"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetHeight(height: EMU): boolean"
    },
    "SetRowPr": {
      "description": "Sets the properties to the current table row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/SetRowPr/",
      "params": [
        {
          "description": "The table row properties.",
          "name": "oApiTableRowPr",
          "type": "ApiTableRowPr"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetRowPr(oApiTableRowPr: ApiTableRowPr): boolean",
      "since": "10.0.0"
    },
    "SetTextPr": {
      "description": "Sets the text properties to the current row.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTableRow/Methods/SetTextPr/",
      "params": [
        {
          "description": "The text properties that will be set to the current row.",
          "name": "oTextPr",
          "type": "ApiTextPr"
        }
      ],
      "returns": {
        "description": "returns false if parent table doesn't exist or param is invalid.",
        "type": "boolean"
      },
      "signature": "SetTextPr(oTextPr: ApiTextPr): boolean",
      "since": "10.0.0"
    }
  }
}
