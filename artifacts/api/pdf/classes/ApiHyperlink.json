{
  "description": "Class representing a Paragraph hyperlink.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiHyperlink/",
  "methods": {
    "GetClassType": {
      "description": "Returns a type of the ApiHyperlink class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiHyperlink/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"hyperlink\""
      },
      "signature": "GetClassType(): \"hyperlink\""
    },
    "GetElement": {
      "description": "Returns the hyperlink element using the position specified.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiHyperlink/Methods/GetElement/",
      "params": [
        {
          "description": "The position where the element which content we want to get must be located.",
          "name": "nPos",
          "type": "number"
        }
      ],
      "returns": {
        "type": "ParagraphContent | null"
      },
      "signature": "GetElement(nPos: number): ParagraphContent | null"
    },
    "GetElementsCount": {
      "description": "Returns a number of elements in the current hyperlink.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiHyperlink/Methods/GetElementsCount/",
      "params": [],
      "returns": {
        "type": "number"
      },
      "signature": "GetElementsCount(): number"
    },
    "GetLinkedText": {
      "description": "Returns the hyperlink address.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiHyperlink/Methods/GetLinkedText/",
      "params": [],
      "returns": {
        "type": "string"
      },
      "signature": "GetLinkedText(): string"
    },
    "GetScreenTipText": {
      "description": "Returns the screen tip text of the hyperlink.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiHyperlink/Methods/GetScreenTipText/",
      "params": [],
      "returns": {
        "type": "string"
      },
      "signature": "GetScreenTipText(): string"
    },
    "GetTextRange": {
      "description": "Returns an ApiTextRange object that represents the part of the text contained in the current hyperlink.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiHyperlink/Methods/GetTextRange/",
      "params": [
        {
          "description": "Start character position (0-based, inclusive) relative to the hyperlink.",
          "name": "start",
          "optional": true,
          "type": "number"
        },
        {
          "description": "End character position (0-based, exclusive). Defaults to the end of the hyperlink.",
          "name": "end",
          "optional": true,
          "type": "number"
        }
      ],
      "returns": {
        "description": "returns null if the hyperlink is not attached to the document or the specified range is empty.",
        "type": "ApiTextRange | null"
      },
      "signature": "GetTextRange(start?: number, end?: number): ApiTextRange | null",
      "since": "10.0.0"
    },
    "SetLink": {
      "description": "Sets the hyperlink address.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiHyperlink/Methods/SetLink/",
      "params": [
        {
          "description": "The hyperlink address.",
          "name": "sLink",
          "type": "string"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetLink(sLink: string): boolean"
    },
    "SetScreenTipText": {
      "description": "Sets the screen tip text of the hyperlink.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiHyperlink/Methods/SetScreenTipText/",
      "params": [
        {
          "description": "The screen tip text of the hyperlink.",
          "name": "sScreenTipText",
          "type": "string"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetScreenTipText(sScreenTipText: string): boolean"
    }
  }
}
