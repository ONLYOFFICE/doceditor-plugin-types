{
  "description": "Class representing a button field.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiButtonField/",
  "extends": [
    "ApiBaseField"
  ],
  "methods": {
    "AddWidget": {
      "description": "Adds new widget - visual representation for field",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/AddWidget/",
      "params": [
        {
          "description": "page index to add widget",
          "name": "pageIndex",
          "type": "number"
        },
        {
          "description": "field rect",
          "name": "rect",
          "type": "Rect"
        },
        {
          "description": "whether the new widget have the same visual and actions settings as the original",
          "name": "isCopy",
          "optional": true,
          "type": "boolean"
        }
      ],
      "returns": {
        "type": "ApiWidget | null"
      },
      "signature": "AddWidget(pageIndex: number, rect: Rect, isCopy?: boolean): ApiWidget | null"
    },
    "Delete": {
      "description": "Removes field from document.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/Delete/",
      "params": [],
      "returns": {
        "type": "boolean"
      },
      "signature": "Delete(): boolean"
    },
    "GetAllWidgets": {
      "description": "Gets array with widgets of the current field.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/GetAllWidgets/",
      "params": [],
      "returns": {
        "description": "returns emptry array if the field is not added to the document.",
        "type": "ApiWidget[]"
      },
      "signature": "GetAllWidgets(): ApiWidget[]"
    },
    "GetClassType": {
      "description": "Returns a type of the ApiButtonField class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiButtonField/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"buttonField\""
      },
      "signature": "GetClassType(): \"buttonField\""
    },
    "GetFullName": {
      "description": "Gets field full name.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/GetFullName/",
      "params": [],
      "returns": {
        "type": "string"
      },
      "signature": "GetFullName(): string"
    },
    "GetInternalId": {
      "description": "Returns an internal ID of the current field.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/GetInternalId/",
      "params": [],
      "requires": "ONLYOFFICE Docs Developer Edition. This member is not present in Community Edition builds.",
      "returns": {
        "type": "string"
      },
      "signature": "GetInternalId(): string",
      "since": "9.4.0"
    },
    "GetPartialName": {
      "description": "Gets field partial name.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/GetPartialName/",
      "params": [],
      "returns": {
        "type": "string"
      },
      "signature": "GetPartialName(): string"
    },
    "GetTooltip": {
      "description": "Gets field tooltip",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/GetTooltip/",
      "params": [],
      "requires": "ONLYOFFICE Docs Developer Edition. This member is not present in Community Edition builds.",
      "returns": {
        "type": "boolean"
      },
      "signature": "GetTooltip(): boolean",
      "since": "9.4.0"
    },
    "GetValue": {
      "description": "Gets image of the button field",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiButtonField/Methods/GetValue/",
      "params": [],
      "returns": {
        "description": "The image URL, or an empty string if the field has no image.",
        "type": "string"
      },
      "signature": "GetValue(): string",
      "since": "10.0.0"
    },
    "IsReadOnly": {
      "description": "Checks if field is read only",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/IsReadOnly/",
      "params": [],
      "returns": {
        "type": "boolean"
      },
      "signature": "IsReadOnly(): boolean"
    },
    "IsRequired": {
      "description": "Checks if field is required",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/IsRequired/",
      "params": [],
      "returns": {
        "type": "boolean"
      },
      "signature": "IsRequired(): boolean"
    },
    "SetFullName": {
      "description": "Sets new field name if possible.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/SetFullName/",
      "params": [
        {
          "description": "The new full name for the field.",
          "name": "name",
          "type": "string"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetFullName(name: string): boolean"
    },
    "SetPartialName": {
      "description": "Sets new field partial name.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/SetPartialName/",
      "params": [
        {
          "description": "The new partial name for the field.",
          "name": "name",
          "type": "string"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetPartialName(name: string): boolean"
    },
    "SetReadOnly": {
      "description": "Sets field read only",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/SetReadOnly/",
      "params": [
        {
          "description": "Specifies whether the field is read-only.",
          "name": "readOnly",
          "type": "boolean"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetReadOnly(readOnly: boolean): boolean"
    },
    "SetRequired": {
      "description": "Sets field required",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/SetRequired/",
      "params": [
        {
          "description": "Specifies whether the field is required.",
          "name": "required",
          "type": "boolean"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetRequired(required: boolean): boolean"
    },
    "SetTooltip": {
      "description": "Sets field tooltip",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/SetTooltip/",
      "params": [
        {
          "description": "The tooltip text for the field.",
          "name": "tooltip",
          "type": "string"
        }
      ],
      "requires": "ONLYOFFICE Docs Developer Edition. This member is not present in Community Edition builds.",
      "returns": {
        "type": "boolean"
      },
      "signature": "SetTooltip(tooltip: string): boolean",
      "since": "9.4.0"
    },
    "SetValue": {
      "description": "Sets image for all button field widgets",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiButtonField/Methods/SetValue/",
      "params": [
        {
          "description": "The URL of the image to set for the button (currently only internet URL or Base64 encoded images are supported)",
          "name": "imageUrl",
          "optional": true,
          "type": "string"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetValue(imageUrl?: string): boolean",
      "since": "9.4.0"
    }
  }
}
