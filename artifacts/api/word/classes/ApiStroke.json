{
  "agents": "https://raw.githubusercontent.com/ONLYOFFICE/plugins-types/main/AGENTS.md",
  "description": "Class representing a stroke.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/",
  "methods": {
    "GetBeginArrow": {
      "description": "Returns the beginning arrow properties of the stroke.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/Methods/GetBeginArrow/",
      "params": [],
      "returns": {
        "type": "object | null"
      },
      "signature": "GetBeginArrow(): object | null",
      "since": "10.0.0"
    },
    "GetClassType": {
      "description": "Returns a type of the ApiStroke class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"stroke\""
      },
      "signature": "GetClassType(): \"stroke\""
    },
    "GetDashType": {
      "description": "Gets the dash type of the stroke.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/Methods/GetDashType/",
      "params": [],
      "returns": {
        "description": "returns dash type (\"solid\", \"dash\", etc.) or null.",
        "type": "DashType | null"
      },
      "signature": "GetDashType(): DashType | null"
    },
    "GetEndArrow": {
      "description": "Returns the ending arrow properties of the stroke.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/Methods/GetEndArrow/",
      "params": [],
      "returns": {
        "type": "object | null"
      },
      "signature": "GetEndArrow(): object | null",
      "since": "10.0.0"
    },
    "GetFill": {
      "description": "Gets the fill (color) of the stroke.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/Methods/GetFill/",
      "params": [],
      "returns": {
        "type": "ApiFill | null"
      },
      "signature": "GetFill(): ApiFill | null"
    },
    "GetWidth": {
      "description": "Gets the width of the stroke in English Metric Units.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/Methods/GetWidth/",
      "params": [],
      "returns": {
        "type": "EMU | null"
      },
      "signature": "GetWidth(): EMU | null"
    },
    "SetBeginArrow": {
      "description": "Sets the beginning arrow of the stroke.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/Methods/SetBeginArrow/",
      "params": [
        {
          "description": "The type of the beginning arrow.",
          "name": "type",
          "type": "LineEndType"
        },
        {
          "description": "The width of the beginning arrow.",
          "name": "width",
          "optional": true,
          "type": "LineEndSize"
        },
        {
          "description": "The length of the beginning arrow.",
          "name": "length",
          "optional": true,
          "type": "LineEndSize"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetBeginArrow(type: LineEndType, width?: LineEndSize, length?: LineEndSize): boolean",
      "since": "10.0.0"
    },
    "SetEndArrow": {
      "description": "Sets the ending arrow of the stroke.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/Methods/SetEndArrow/",
      "params": [
        {
          "description": "The type of the ending arrow.",
          "name": "type",
          "type": "LineEndType"
        },
        {
          "description": "The width of the ending arrow.",
          "name": "width",
          "optional": true,
          "type": "LineEndSize"
        },
        {
          "description": "The length of the ending arrow.",
          "name": "length",
          "optional": true,
          "type": "LineEndSize"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetEndArrow(type: LineEndType, width?: LineEndSize, length?: LineEndSize): boolean",
      "since": "10.0.0"
    },
    "ToJSON": {
      "description": "Converts the ApiStroke object into the JSON object.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiStroke/Methods/ToJSON/",
      "params": [],
      "returns": {
        "type": "object"
      },
      "signature": "ToJSON(): object"
    }
  }
}
