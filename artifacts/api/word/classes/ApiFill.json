{
  "description": "Class representing a base class for fill.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiFill/",
  "methods": {
    "GetClassType": {
      "description": "Returns a type of the ApiFill class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiFill/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"fill\""
      },
      "signature": "GetClassType(): \"fill\""
    },
    "GetColor": {
      "description": "Returns the color of a solid fill.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiFill/Methods/GetColor/",
      "params": [],
      "returns": {
        "type": "ApiColor | null"
      },
      "signature": "GetColor(): ApiColor | null",
      "since": "10.0.0"
    },
    "GetTransparent": {
      "description": "Returns the transparency of the fill.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiFill/Methods/GetTransparent/",
      "params": [],
      "returns": {
        "description": "The transparency value, from 0 (fully opaque) to 1 (fully transparent).",
        "type": "number"
      },
      "signature": "GetTransparent(): number",
      "since": "10.0.0"
    },
    "GetType": {
      "description": "Gets the fill type.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiFill/Methods/GetType/",
      "params": [],
      "returns": {
        "description": "returns \"solid\", \"gradient\", \"pattern\", \"blip\", \"nofill\" or null.",
        "type": "FillType"
      },
      "signature": "GetType(): FillType"
    },
    "SetTransparent": {
      "description": "Sets the transparency of the fill.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiFill/Methods/SetTransparent/",
      "params": [
        {
          "description": "The transparency value, from 0 (fully opaque) to 1 (fully transparent).",
          "name": "transparent",
          "type": "number"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetTransparent(transparent: number): boolean",
      "since": "10.0.0"
    },
    "ToJSON": {
      "description": "Converts the ApiFill object into the JSON object.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiFill/Methods/ToJSON/",
      "params": [],
      "returns": {
        "type": "string"
      },
      "signature": "ToJSON(): string"
    }
  }
}
